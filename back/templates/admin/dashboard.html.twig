{% extends '@EasyAdmin/page/content.html.twig' %}

{% macro fmtNames(names) %}
    {% if names is empty %}Aucun
    {% elseif names|length == 1 %}{{ names|first }}
    {% elseif names|length == 2 %}{{ names[0] }} et {{ names[1] }}
    {% else %}{{ names|length }} ex-aequo
    {% endif %}
{% endmacro %}

{% block main %}
    {% import _self as macros %}

    <div class="mb-4">
        <p class="text-muted">{{ constant('App\\Constants\\AdminConstants::DASHBOARD_WELCOME') }}</p>
    </div>

    {% for section in sections %}
        {% if section.title %}
            <h5 class="text-gold fw-bold mt-5 mb-3" style="font-style: italic; font-size: 1.05rem; letter-spacing: 0.5px;">
                {{ section.title }}
            </h5>
        {% endif %}
        
        {% set count = section.metrics|length %}
        {% set col_class = 'col-12 col-md-6' %}
        
        {% if count == 4 %}
            {% set col_class = 'col-12 col-md-6 col-xl-3' %}
        {% elseif count == 3 %}
            {% set col_class = 'col-12 col-lg-4' %}
        {% endif %}
        
        <div class="row">
            {% for metric in section.metrics %}
                {% set display_value = metric.names is not empty ? macros.fmtNames(metric.names) : metric.value %}
                
                <div class="{{ col_class }} mb-4">
                    {% include 'admin/components/_kpi_card.html.twig' with {
                        id: metric.id,
                        title: metric.title,
                        hint: metric.hint,
                        value: display_value,
                        names: metric.names,
                        suffix: metric.suffix,
                        subtext: metric.subtext,
                        icon: metric.icon,
                        color: metric.color
                    } %}
                </div>
            {% endfor %}
        </div>
    {% endfor %}
{% endblock %}