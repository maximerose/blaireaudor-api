#!/bin/sh

echo "🐶 Husky vérifie la qualité et le style..."

# --- 1. QUALITÉ FRONT (ESLint) ---
echo "🧹 Nettoyage des scripts Front (ESLint)..."
docker compose run --rm quality eslint front/src --fix --max-warnings 0 || exit 1

# --- 1.5 TYPAGE FRONT (TypeScript) ---
echo "🟦 Vérification des types (TypeScript)..."
docker compose run --rm quality sh -c "cd front && npx tsc -b" || exit 1

# --- 2. STYLE FRONT (Prettier) ---
echo "✨ Embellissement du Front (Prettier)..."
docker compose run --rm quality npx prettier --write front/src --log-level warn

# --- 3. STYLE BACK (PHP-CS-Fixer) ---
echo "🐘 Mise en forme du code PHP (PHP-CS-Fixer)..."
docker compose exec -T back vendor/bin/php-cs-fixer fix src --diff --ansi

# --- 4. TESTS UNITAIRES BACK (PHPUnit) ---
echo "🧪 Vérification de la logique (Tests Unitaires)..."
docker compose exec -T back bin/phpunit tests/Unit || exit 1

# --- 4. AUTO-STAGING ---
echo "📦 Archivage des corrections automatiques..."
git add .

echo "✅ Tout est propre, réparé et ajouté au commit ! 🏆"